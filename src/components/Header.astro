---
import SealMark from './SealMark.astro';

const links = [
  { href: '/framework/', label: 'Framework' },
  { href: '/verification/', label: 'Verification' },
  { href: '/principles/', label: 'Principles' },
  { href: '/comparison/', label: 'Comparison' },
  { href: '/requirements/', label: 'Requirements' },
  { href: '/domains/', label: 'Domains' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-rule-faint bg-panel/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2.5">
      <SealMark class="size-6 text-seal-600" />
      <span class="expanded text-[17px] font-semibold tracking-tight text-ink">Signatif</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-ink-2 lg:flex" aria-label="Primary">
      {links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={current.startsWith(href) ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-ink',
            current.startsWith(href) ? 'font-medium text-azure-700' : '',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <a
        href="https://github.com/CalConnect/cc-signatif"
        aria-label="Standard source on GitHub"
        class="grid size-9 place-items-center text-ink-2 transition-colors hover:text-ink"
      >
        <svg viewBox="0 0 16 16" class="size-[19px]" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </a>
      <details class="group relative lg:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center text-ink-2 transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav
          class="shadow-panel absolute right-0 top-full mt-2 w-48 rounded-lg border border-rule bg-panel p-2"
          aria-label="Mobile"
        >
          {links.map(({ href, label }) => (
            <a
              href={href}
              aria-current={current.startsWith(href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2 text-sm transition-colors hover:bg-azure-50',
                current.startsWith(href) ? 'font-medium text-azure-700' : 'text-ink-2',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
