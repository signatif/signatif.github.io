---
const letters = [
  { letter: 'S', word: 'Sealed', text: 'Co-signatures over a canonical payload, one per trust dimension. Convergence, not single-signer authority.' },
  { letter: 'I', word: 'Interoperable', text: 'One pipeline, one coverage-report format. Scheme-specific rules enter through registries, not forks.' },
  { letter: 'G', word: 'Graduated', text: 'Coverage report, classification label, acceptance decision. Trust in degrees, computed identically by every verifier.' },
  { letter: 'N', word: 'Non-repudiable', text: 'Threshold quorum, ceremony records, transparency logs. No participant can deny an attestation made in its name.' },
  { letter: 'A', word: 'Anchored', text: 'Every verification path ends at a declared trust anchor. Fully offline verification — no phone-home, no proprietary component.' },
  { letter: 'T', word: 'Trust', text: 'Establishment, assessment, and withdrawal. Revocation propagates to every artifact transitively bound to it.' },
  { letter: 'I', word: 'Infrastructure', text: 'Shared anchors, logs, and registries beneath any application that needs verifiable artifacts.' },
  { letter: 'F', word: 'Framework', text: 'Not a product. Requirements that independent implementations conform to, and profiles instantiate.' },
];
---
<section id="principles" class="mx-auto max-w-6xl px-6 py-16 md:py-20">
  <div class="max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight text-ink-900 dark:text-ink-50 md:text-3xl">Principles</h2>
    <p class="mt-3 text-ink-600 dark:text-ink-300">
      Signatif is a backronym: each letter names a property the standard
      makes normative.
    </p>
  </div>
  <div class="mt-10 overflow-x-auto">
    <table class="w-full min-w-[40rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-ink-300 dark:border-ink-700">
          <th class="w-14 py-3 pr-4 text-xs font-medium uppercase tracking-wider text-ink-400 dark:text-ink-500">Letter</th>
          <th class="w-44 py-3 pr-4 text-xs font-medium uppercase tracking-wider text-ink-400 dark:text-ink-500">Property</th>
          <th class="py-3 text-xs font-medium uppercase tracking-wider text-ink-400 dark:text-ink-500">Requirement summary</th>
        </tr>
      </thead>
      <tbody>
        {letters.map(({ letter, word, text }) => (
          <tr class="border-b border-ink-200 align-top dark:border-ink-800">
            <td class="py-4 pr-4 font-mono text-sm font-medium text-seal-600 dark:text-seal-400">{letter}</td>
            <td class="py-4 pr-4 text-sm font-medium text-ink-900 dark:text-ink-50">{word}</td>
            <td class="py-4 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{text}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
