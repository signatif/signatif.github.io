---
const steps = [
  {
    n: '1',
    title: 'Seal and delegate',
    tag: 'artifact',
    text: 'Authorities sign artifacts and delegate through a chain. Authorization scope narrows monotonically at every link.',
  },
  {
    n: '2',
    title: 'Verify',
    tag: 'coverage report',
    text: 'Hard checks short-circuit to rejected. Soft checks accumulate into an objective coverage report.',
  },
  {
    n: '3',
    title: 'Classify',
    tag: 'classification label',
    text: 'The scheme’s published policy maps the report to a label — a pure, deterministic function.',
  },
  {
    n: '4',
    title: 'Accept',
    tag: 'acceptance policy',
    text: 'The verifier’s own risk policy turns the label into a decision for its context.',
  },
];
---
<section id="pipeline" class="border-y border-ink-200 bg-ink-50/60 dark:border-ink-800 dark:bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink-900 dark:text-ink-50 md:text-3xl">Verification pipeline</h2>
      <p class="mt-3 text-ink-600 dark:text-ink-300">
        The standard separates what is verified, how it is graded, and whether
        it is good enough — so schemes and verifiers can differ without
        forking the machinery.
      </p>
    </div>
    <ol class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
      {steps.map(({ n, title, tag, text }) => (
        <li class="border-t-2 border-ink-300 pt-5 dark:border-ink-700">
          <span class="font-mono text-sm text-ink-400 dark:text-ink-500">{n}</span>
          <h3 class="mt-2 text-[15px] font-semibold text-ink-900 dark:text-ink-50">{title}</h3>
          <p class="mt-0.5 font-mono text-xs text-ink-400 dark:text-ink-500">{tag}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
