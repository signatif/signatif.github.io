---
const facts = [
  { label: 'Organization', value: 'CalConnect' },
  { label: 'Verification', value: 'Offline capable' },
  { label: 'Algorithms', value: 'Post-quantum agile' },
  { label: 'Attestation', value: 'Multi-dimensional' },
];
---
<section id="top" class="border-b border-ink-200 dark:border-ink-800">
  <div class="mx-auto max-w-6xl px-6 pb-16 pt-14 md:pt-20">
    <p class="text-sm font-medium text-ink-500 dark:text-ink-400">
      Trust infrastructure for verifiable artifacts
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-ink-900 dark:text-ink-50 md:text-5xl">
      Evidence, not faith.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
      Signatif is an open framework for sealing, delegating, and verifying
      artifacts in regulated industries. It replaces binary trust with
      graduated, reproducible evidence — computed the same way by every
      conforming verifier.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href="https://github.com/CalConnect/cc-signatif"
        class="bg-ink-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink-700 dark:bg-ink-100 dark:text-ink-900 dark:hover:bg-white"
      >
        Read the standard
      </a>
      <a
        href="#verifier"
        class="text-sm font-medium text-ink-700 transition-colors hover:text-seal-600 dark:text-ink-200 dark:hover:text-seal-400"
      >
        Try the verifier demo
      </a>
    </div>
    <p class="mt-10 font-mono text-xs text-ink-400 dark:text-ink-500">
      A CalConnect standard · from Latin <span class="italic">signare</span>, "to mark with a seal"
    </p>
    <dl class="mt-8 grid grid-cols-2 border-t border-ink-200 dark:border-ink-800 lg:grid-cols-4">
      {facts.map(({ label, value }, i) => (
        <div class:list={['py-4 pr-6', i > 0 && 'lg:border-l lg:border-ink-200 lg:pl-6 dark:lg:border-ink-800']}>
          <dt class="text-xs uppercase tracking-wider text-ink-400 dark:text-ink-500">{label}</dt>
          <dd class="mt-1 text-sm font-medium text-ink-800 dark:text-ink-100">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
