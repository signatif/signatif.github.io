---
import SealMark from './SealMark.astro';
---
<footer class="border-t border-ink-200 dark:border-ink-800">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <SealMark class="size-5 text-seal-600 dark:text-seal-400" />
          <span class="text-[15px] font-semibold tracking-tight text-ink-900 dark:text-ink-50">Signatif</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-500 dark:text-ink-400">
          From Latin <span class="italic">signare</span> — to mark with a seal.
          Trustworthiness is established by what is verifiably signed,
          not by who is trusted.
        </p>
      </div>
      <nav class="text-sm text-ink-600 dark:text-ink-300">
        <p class="text-xs font-medium uppercase tracking-wider text-ink-400 dark:text-ink-500">Site</p>
        <ul class="mt-3 space-y-2">
          <li><a href="#principles" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">Principles</a></li>
          <li><a href="#pipeline" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">Pipeline</a></li>
          <li><a href="#verifier" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">Verifier</a></li>
          <li><a href="#domains" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">Domains</a></li>
        </ul>
      </nav>
      <nav class="text-sm text-ink-600 dark:text-ink-300">
        <p class="text-xs font-medium uppercase tracking-wider text-ink-400 dark:text-ink-500">Source</p>
        <ul class="mt-3 space-y-2">
          <li><a href="https://github.com/CalConnect/cc-signatif" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">Standard</a></li>
          <li><a href="https://github.com/signatif/signatif.github.io" class="transition-colors hover:text-ink-900 dark:hover:text-ink-50">This website</a></li>
        </ul>
      </nav>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-ink-200 pt-6 dark:border-ink-800">
      <p class="text-xs text-ink-400 dark:text-ink-500">
        Sealed · Interoperable · Graduated · Non-repudiable · Anchored
      </p>
      <p class="text-xs text-ink-400 dark:text-ink-500">A CalConnect standard</p>
    </div>
  </div>
</footer>
