---
import SealMark from './SealMark.astro';
---
<footer class="border-t border-rule-faint bg-paper">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="https://www.calconnect.org/" class="group inline-block">
          <span class="expanded-wide font-futura text-[26px] font-medium leading-none tracking-[0.02em] text-[#485094] transition-opacity group-hover:opacity-80">
            CALCONNECT
          </span>
          <span class="mt-1.5 block text-xs text-ink-3">The Calendaring and Scheduling Consortium</span>
        </a>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-2">
          Signatif is developed in CalConnect. From Latin&#32;<span class="italic">signare</span>&#32;— to mark with a seal.
          Trustworthiness by what is verifiably signed, not by who is trusted.
        </p>
      </div>
      <nav aria-label="Site">
        <p class="label-mono text-ink-3">Site</p>
        <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
          <li><a href="/framework/" class="transition-colors hover:text-ink">Framework</a></li>
          <li><a href="/verification/" class="transition-colors hover:text-ink">Verification</a></li>
          <li><a href="/principles/" class="transition-colors hover:text-ink">Principles</a></li>
          <li><a href="/comparison/" class="transition-colors hover:text-ink">Comparison</a></li>
          <li><a href="/requirements/" class="transition-colors hover:text-ink">Requirements</a></li>
          <li><a href="/schemes/" class="transition-colors hover:text-ink">Schemes</a></li>
          <li><a href="/glossary/" class="transition-colors hover:text-ink">Glossary</a></li>
          <li><a href="/domains/" class="transition-colors hover:text-ink">Domains</a></li>
          <li><a href="/implementations/" class="transition-colors hover:text-ink">Implementations</a></li>
          <li><a href="/about/" class="transition-colors hover:text-ink">About</a></li>
        </ul>
      </nav>
      <nav aria-label="Source">
        <p class="label-mono text-ink-3">Source</p>
        <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
          <li><a href="https://github.com/CalConnect/cc-signatif" class="transition-colors hover:text-ink">Standard (cc-signatif)</a></li>
          <li><a href="https://github.com/signatif/signatif.github.io" class="transition-colors hover:text-ink">This website</a></li>
          <li><a href="https://www.calconnect.org/" class="transition-colors hover:text-ink">CalConnect</a></li>
        </ul>
      </nav>
    </div>
    <div class="vernier mt-12 text-rule" aria-hidden="true"></div>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <p class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">
        <SealMark class="size-3.5 text-seal-600" />
        Sealed · Interoperable · Graduated · Non-repudiable · Anchored
      </p>
      <p class="font-mono text-[11px] text-ink-3">A CalConnect standard</p>
    </div>
  </div>
</footer>
