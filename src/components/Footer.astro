---
import SealMark from './SealMark.astro';
---
<footer class="border-t border-ink-900/10 dark:border-parchment-100/10">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5 text-seal-600 dark:text-seal-400">
          <SealMark class="size-6" />
          <span class="font-display text-lg font-semibold tracking-tight text-ink-900 dark:text-parchment-100">signatif</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-500 dark:text-parchment-300">
          From Latin <span class="italic">signare</span> — to mark with a seal.
          Trustworthiness is established by what is verifiably signed,
          not by who is trusted.
        </p>
      </div>
      <nav class="font-mono text-xs uppercase tracking-widest text-ink-500 dark:text-parchment-300">
        <p class="text-ink-400 dark:text-parchment-300/70">Site</p>
        <ul class="mt-3 space-y-2.5">
          <li><a href="#principles" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Principles</a></li>
          <li><a href="#pipeline" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Pipeline</a></li>
          <li><a href="#verifier" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Verifier</a></li>
          <li><a href="#domains" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Domains</a></li>
        </ul>
      </nav>
      <nav class="font-mono text-xs uppercase tracking-widest text-ink-500 dark:text-parchment-300">
        <p class="text-ink-400 dark:text-parchment-300/70">Source</p>
        <ul class="mt-3 space-y-2.5">
          <li><a href="https://github.com/CalConnect/cc-signatif" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Standard</a></li>
          <li><a href="https://github.com/CalConnect/cc-signatif/pulls" class="transition-colors hover:text-seal-600 dark:hover:text-seal-400">Pull requests</a></li>
        </ul>
        <p class="mt-6 text-ink-400 dark:text-parchment-300/70">Status</p>
        <p class="mt-3">ISO/TC 154 · working draft</p>
      </nav>
    </div>
    <div class="ledger-strip mt-12 text-ink-900/25 dark:text-parchment-100/20" aria-hidden="true"></div>
    <p class="mt-6 font-mono text-[11px] text-ink-400 dark:text-parchment-300">
      Sealed. Interoperable. Graduated. Non-repudiable. Anchored.
    </p>
  </div>
</footer>
