---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---
<div class="bg-paper">
  <div class="mx-auto max-w-6xl px-6 pb-10 pt-10 md:pt-14">
    <p class="label-mono text-azure-600">{eyebrow}</p>
    <h1 class="expanded mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-ink md:text-[2.75rem] md:leading-[1.15]">
      {title}
    </h1>
    {lede && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-2">{lede}</p>}
    <div class="vernier mt-10 text-rule"></div>
  </div>
</div>
