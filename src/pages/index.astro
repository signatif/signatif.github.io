---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import Pipeline from '../components/Pipeline.astro';
import VerifierDemo from '../components/VerifierDemo.vue';
import Industries from '../components/Industries.astro';
---
<Layout
  title="Signatif — Evidence, not faith."
  description="Signatif is an open trust infrastructure framework for verifiable artifacts in regulated industries: sealed, interoperable, graduated, non-repudiable, anchored."
>
  <Hero />
  <Principles />
  <Pipeline />
  <section id="verifier" class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink-900 dark:text-ink-50 md:text-3xl">Verifier demo</h2>
      <p class="mt-3 text-ink-600 dark:text-ink-300">
        Toggle the checks. The coverage report is objective, the label is the
        scheme’s policy, and the decision is the verifier’s.
      </p>
    </div>
    <div class="mt-10">
      <VerifierDemo client:load />
    </div>
  </section>
  <Industries />
</Layout>
